# Copy this file to server/.env and fill in the values. Never commit server/.env.

NODE_ENV=development
PORT=5000

# MongoDB connection string.
#  • Atlas (dev):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/airlab?retryWrites=true&w=majority
#  • Local / NED:   mongodb://127.0.0.1:27017/airlab
MONGO_URI=

# Origins allowed to call the API with credentials (comma-separated).
# Not needed in dev when using the Vite proxy, but keep the Vite URL here anyway.
CORS_ORIGINS=http://localhost:5173

# Public site URL used in notification emails (no trailing slash)
PUBLIC_SITE_URL=https://airlab-website-peach.vercel.app

# Admin Auth (must be at least 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace-with-a-64-byte-cryptographic-random-hex-secret-in-prod

# Email notifications for applicant submissions
ADMIN_NOTIFICATION_EMAIL=admissions@example.edu.pk
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: Upstash Redis REST API for distributed rate limiting (falls back to in-memory per instance when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile CAPTCHA protection for the public application form
# Server secret key (when set, requires a valid turnstileToken on POST /api/applications)
TURNSTILE_SECRET_KEY=
# Frontend site key (set in root .env / Vercel env vars so Vite exposes it to the client modal)
VITE_TURNSTILE_SITE_KEY=

